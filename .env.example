# Copy to .env (gitignored) and fill in only what you want to change. Never commit .env.
# Canvas needs no token: click "Connect Canvas" in LectureLab and sign in with your school login there.
# These two are normally set in the app. A value here overrides what the app has saved.

# CANVAS_BASE_URL=https://school.instructure.com
# LECTURELAB_NOTES_DIR=C:\Users\you\Documents\LectureLab Notes
# LECTURELAB_PORT=8765
# LECTURELAB_MIN_UNITS=20            # below this many paid Colab units, transcribe on the CPU
# LECTURELAB_UPLOAD_CHUNK_MB=8       # Colab uploads go up in parts this size
