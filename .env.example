# Copy to .env (gitignored) and fill in only what you want to change. Never commit .env.
# Canvas needs no token: click "Connect Canvas" in LectureLab and sign in with GatorLink there.

# CANVAS_BASE_URL=https://ufl.instructure.com
# LECTURELAB_PORT=8765
# LECTURELAB_MIN_UNITS=20            # below this many paid Colab units, transcribe on the CPU
# LECTURELAB_UPLOAD_CHUNK_MB=8       # Colab uploads go up in parts this size
